{
  "name": "nexora-training-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "lint": "eslint .",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand --coverage",
    "rbac:matrix": "node scripts/rbac-matrix.js",
    "seed": "node scripts/seed.js",
    "clean:demo-data": "node scripts/clean-demo-data.js",
    "remove:fullstack-course": "node scripts/remove-fullstack-course.js",
    "rename:demo-employee-emails": "node scripts/rename-demo-employee-emails.js",
    "repair:demo-resources": "node scripts/repair-demo-resources.js",
    "videos:verify": "node scripts/verify-course-videos.mjs",
    "client:dev": "npm --prefix frontend run dev -- --host 0.0.0.0",
    "client:build": "npm --prefix frontend run build",
    "client:preview": "npm --prefix frontend run preview -- --host 0.0.0.0",
    "seed:compliance": "node scripts/seed-compliance.js",
    "ensure:code-of-conduct": "node scripts/ensure-code-of-conduct-assignment.js"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.5.0",
    "file-type": "^21.3.2",
    "framer-motion": "^13.4.5",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.2",
    "lucide-react": "^1.48.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "multer": "2.4.0",
    "node-cron": "4.6.0",
    "nodemailer": "10.0.11",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "react-router-dom": "^7.18.4",
    "recharts": "^3.10.1",
    "sanitize-html": "^2.17.7",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.7.0",
    "autoprefixer": "^10.6.1",
    "eslint": "^9.17.0",
    "eslint-plugin-security": "^3.0.1",
    "jest": "30.2.0",
    "mongodb-memory-server": "^10.1.3",
    "postcss": "^8.5.28",
    "prettier": "^3.4.2",
    "supertest": "^7.0.0",
    "tailwindcss": "^3.4.19",
    "vite": "^6.4.0"
  }
}
